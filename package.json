{
  "name": "@marukohe/gate",
  "version": "1.2.0",
  "description": "Monitor and continue Codex and Antigravity sessions across SSH servers",
  "type": "module",
  "bin": {
    "gate": "bin/gate.js"
  },
  "files": [
    "bin/",
    "server/dist/",
    "client/dist/"
  ],
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "prepare": "npm run build",
    "test:ui": "node tools/browser-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "ssh2": "^1.17.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.59.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marukohe/Gate.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
